# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit live secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
GOOGLE_MAPS_API_KEY=
# Razorpay Checkout (Flutter) + Route (Supabase edge functions).
# Use TEST mode keys (rzp_test_...) until go-live. Never commit secrets.
# Flutter only needs KEY_ID (public). KEY_SECRET is server-only — set it as a
# Supabase secret (`supabase secrets set RAZORPAY_KEY_SECRET=...`), not in a
# bundled client .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Store listings. Leave empty until a real listing exists.
# Do NOT set PLAY_STORE_URL to https://play.google.com/store/apps/details?id=com.hotpotchef.app
# unless that package is published (it currently 404s). The Android applicationId
# is com.hotpotchef.app and is used for installed-app intents only.
PLAY_STORE_URL=
APP_STORE_URL=

# Push / edge functions. Token sync is client-side. Order-status FCM needs
# supabase/migrations push-webhook SQL + Vault `edge_service_role_key`
# (see supabase/README.md).
# FCM_SERVER_KEY=
# FIREBASE_SERVICE_ACCOUNT=
# SUPABASE_SERVICE_ROLE_KEY=
